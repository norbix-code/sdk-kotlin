{
  "repositoryUrl": "https://github.com/norbix-code/sdk-kotlin.git",
  "branches": [
    "main",
    { "name": "next", "prerelease": "rc" },
    { "name": "beta", "prerelease": "beta" }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "breaking": true, "release": "major" },
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "docs", "scope": "readme", "release": "patch" },
          { "type": "chore", "release": false },
          { "type": "test", "release": false },
          { "type": "ci", "release": false },
          { "type": "style", "release": false }
        ]
      }
    ],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/exec",
      {
        "verifyConditionsCmd": "for v in ORG_GRADLE_PROJECT_mavenCentralUsername ORG_GRADLE_PROJECT_mavenCentralPassword ORG_GRADLE_PROJECT_signingInMemoryKey ORG_GRADLE_PROJECT_signingInMemoryKeyPassword; do if [ -z \"$(printenv $v)\" ]; then echo \"$v is not set: add the Maven Central / signing secrets before releasing\" >&2; exit 1; fi; done",
        "publishCmd": "NORBIX_VERSION=${nextRelease.version} ./gradlew publishAndReleaseToMavenCentral --no-configuration-cache"
      }
    ],
    "@semantic-release/github"
  ]
}
